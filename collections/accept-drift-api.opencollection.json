          "http": {
            "method": "GET",
            "url": "http://localhost:8080/v1/drift/entities/:kind/:entity_id/observations",
            "params": [
              {
                "name": "kind",
                "value": "",
                "type": "path"
              },
              {
                "name": "entity_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List DriftObservations for a governed entity target"
        }
      ]
    }
  ],
  "bundled": true
}