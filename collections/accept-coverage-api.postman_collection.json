          "name": "List governance coverage records",
          "request": {
            "name": "List governance coverage records",
            "description": {
              "content": "Returns merged GOVERNANCE_CONDITION_DETECTED / GOVERNANCE_COVERAGE_GAP runtime audit events as coverage records keyed by (envelope_id, expectation_id, expectation_version). Each response includes a fixed limitations array describing the read model's scope and correlation semantics — see Issue #56. Requires platform.viewer or above.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "coverage"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "request_source",
                  "value": "<string>"
                },
                {
                  "disabled": false,
                  "key": "request_id",
                  "value": "<string>"
                },
                {
                  "disabled": false,
                  "key": "envelope_id",
                  "value": "<string>"
                },
                {
                  "disabled": false,
                  "key": "process_id",
                  "value": "<string>"
                },
                {
                  "disabled": false,
                  "key": "expectation_id",
                  "value": "<string>"
                },
                {
                  "disabled": false,
                  "key": "since",
                  "value": "<dateTime>",
                  "description": "RFC3339 timestamp; inclusive lower bound on event occurred_at."
                },
                {
                  "disabled": false,
                  "key": "until",
                  "value": "<dateTime>",
                  "description": "RFC3339 timestamp; exclusive upper bound on event occurred_at."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "Positive integer; capped at the audit list maximum. Oversize values are rejected with 400."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
