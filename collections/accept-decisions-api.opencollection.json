{
  "opencollection": "1.0.0",
  "info": {
    "name": "MIDAS Agents Decisions API",
    "version": "1.1.0-rc.1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Decisions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Look up a decision by request ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:8080/v1/decisions/request/:requestId",
            "params": [
              {
                "name": "requestId",
                "value": "",
                "type": "path"
              },
              {
                "name": "source",
                "value": "",
                "type": "query",
                "description": "Request source system. Scopes the lookup to a specific origin."
              }
            ]
          },
          "docs": "Returns the governance envelope for a given caller-supplied request ID. Optionally scoped by source system via the source query parameter.\n"
        }
      ]
    }
  ],
  "bundled": true
}