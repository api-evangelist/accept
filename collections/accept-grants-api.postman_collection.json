                  "key": "agent_id",
                  "value": "<string>",
                  "description": "Filter grants by agent ID. Mutually exclusive with profile_id."
                },
                {
                  "disabled": false,
                  "key": "profile_id",
                  "value": "<string>",
                  "description": "Filter grants by profile ID. Mutually exclusive with agent_id."
